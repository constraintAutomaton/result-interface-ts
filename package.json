{
  "name": "result-interface",
  "type": "module",
  "author": {
    "name": "Bryan-Elliott Tam"
  },
  "description": "A tiny utility (mainly interfaces) with zero dependencies to standardize handling results that may succeed or fail, inspired by Go-style error handling.",
  "homepage": "https://github.com/constraintAutomaton/result-interface-ts",
  "license": "MIT",
  "version": "2.4.1",
  "keywords": [
    "type-safety",
    "typing",
    "error-handling",
    "typescript-utility",
    "safe-result",
    "safe-promises"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./vitest": {
      "import": {
        "types": "./dist/testing/vitest.d.ts",
        "default": "./dist/testing/vitest.js"
      },
      "require": {
        "types": "./dist/testing/vitest.d.cts",
        "default": "./dist/testing/vitest.cjs"
      }
    },
    "./jest": {
      "import": {
        "types": "./dist/testing/jest.d.ts",
        "default": "./dist/testing/jest.js"
      },
      "require": {
        "types": "./dist/testing/jest.d.cts",
        "default": "./dist/testing/jest.cjs"
      }
    },
    "./bun": {
      "import": {
        "types": "./dist/testing/bun.d.ts",
        "default": "./dist/testing/bun.js"
      },
      "require": {
        "types": "./dist/testing/bun.d.cts",
        "default": "./dist/testing/bun.cjs"
      }
    },
    "./chai": {
      "import": {
        "types": "./dist/testing/chai.d.ts",
        "default": "./dist/testing/chai.js"
      },
      "require": {
        "types": "./dist/testing/chai.d.cts",
        "default": "./dist/testing/chai.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "bun run test:bun && bun run test:vitest && bun run test:jest",
    "test:bun": "bun test bun.test",
    "test:vitest": "vitest run",
    "test:jest": "jest",
    "publish-npm": "bun run build && npm publish"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@types/bun": "latest",
    "@vitest/coverage-v8": "^4.1.11",
    "chai": "^6.2.2",
    "jest": "^30.4.2",
    "tsup": "^8.5.1",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "typescript": "^5",
    "vitest": "*",
    "@jest/globals": "*",
    "chai": "*"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    },
    "@jest/globals": {
      "optional": true
    },
    "chai": {
      "optional": true
    }
  }
}
